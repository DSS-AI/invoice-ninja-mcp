# Invoice Ninja (v5, selbst gehostet oder Cloud). Token: IN → Einstellungen → Kontoverwaltung → API-Tokens
INVOICE_NINJA_URL=https://in.example.de
INVOICE_NINJA_API_TOKEN=

# Ein Zugang je Aufrufer; der Name hinter MCP_TOKEN_ erscheint im Log.
# Erzeugen: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKEN_DESKTOP=

# Optional: Host-Port (nur 127.0.0.1), Standard 8539
# HOST_PORT=8539

# Optional: Anbindung an eine PMS-Datenbank (Angebotsvorlagen, Protokoll neuer Entwürfe) und eine
# gemeinsame Log-Datei (sonst weglassen)
# PMS_DB_PATH=/data/risikobeurteilung.db
# LOG_DATEI=/data/ab_sync.log

# Optional: Welche Quelle darf per X-Forwarded-For die im Access-Log protokollierte Client-IP
# setzen. Standard 127.0.0.1 (nur ein Proxy/Tunnel auf demselben Host). Läuft der vorgeschaltete
# Reverse-Proxy/Tunnel von einer anderen Adresse aus (z.B. Docker-Netz), hier anpassen - sonst kann
# jeder Client seine IP im Log fälschen.
# FORWARDED_ALLOW_IPS=127.0.0.1
